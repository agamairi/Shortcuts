    <string name="accessibility_disclosure_title">Automation accessibility disclosure</string>
    <string name="accessibility_disclosure_acknowledge">I understand and want to enable UI automation actions</string>
    <string name="accessibility_disclosure_heading">Tap or Type on Screen</string>
    <string name="accessibility_disclosure_access">This optional feature lets a shortcut you created interact with the app currently on screen. It can read visible text, labels, and view identifiers in the active window so it can find the button or field you selected.</string>
    <string name="accessibility_disclosure_use">It is used only for automations that you create and trigger yourself. It is not needed for messages, calls, web requests, widgets, or other shortcuts. You can leave it off and those features will still work.</string>
    <string name="accessibility_disclosure_settings">After you acknowledge this disclosure, Android will show its own Accessibility settings screen. You can turn the service off at any time in Android settings.</string>
